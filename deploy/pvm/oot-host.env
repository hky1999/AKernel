# SPDX-License-Identifier: Apache-2.0
# Immutable, reviewed host-module inputs. This is not a guest-kernel source pin.
# The fork commit contains generic OOT fixes and a locked Ubuntu target series.
# Prepare the target from its separate baseline before building the module pair.
# The baseline explicitly backports the upstream pvm-612 OSPKE guard fix.
PVM_HOST_SOURCE_REPOSITORY=https://github.com/hky1999/linux.git
PVM_HOST_SOURCE_COMMIT=0994bb5a0808c2c0ea0c58e8fe21828f1afe29df
PVM_HOST_BASELINE_COMMIT=b390d49281cf80fe3d6938528c49d4f632e71ecf
PVM_HOST_TARGET_PROFILE=tools/pvm-oot/profiles/ubuntu-7.0.0-30-generic/profile.json
PVM_HOST_UPSTREAM_REPOSITORY=https://github.com/virt-pvm/linux
PVM_HOST_UPSTREAM_BRANCH=pvm-6.12-host-oot
PVM_HOST_UPSTREAM_COMMIT=71b35309f8698bb664dbed0028156c82b8ec79b8
PVM_HOST_QUALIFIED_KERNEL=7.0.0-30-generic
